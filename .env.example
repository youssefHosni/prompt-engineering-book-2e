# Copy to .env and fill in. Never commit .env.
# Check `git check-ignore -v .env` returns a match before your first commit.

# What the book's listings assume. Needed for tool use (§8.5, §9.1).
ANTHROPIC_API_KEY=

# How the book's own measurements were gathered. Either key is enough for
# most chapters; see §2.5 on why an aggregator is for exploring, not shipping.
OPENROUTER_API_KEY=

# Only for the "On other providers" comparisons.
OPENAI_API_KEY=
GOOGLE_API_KEY=
